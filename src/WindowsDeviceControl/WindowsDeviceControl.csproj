<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 is the LTS most Windows kiosk, signage and IoT deployments actually run; net10.0 is
         carried for consumers already on current. Nothing here needs a language or runtime feature
         newer than .NET 8: LibraryImport is .NET 7+, and the WinRT projections used for radio power
         and Bluetooth are .NET 6+. The 10.0.19041.0 platform floor is what the WinRT
         Windows.Devices.* projections and the WLAN API require. -->
    <TargetFrameworks>net8.0-windows10.0.19041.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <RootNamespace>WindowsDeviceControl</RootNamespace>
    <AssemblyName>WindowsDeviceControl</AssemblyName>

    <!-- Unsafe code reads native buffers and fixed-size native structs (WLAN, CCD, backlight,
         Core Audio). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Public surface: every exported member carries documentation, and a missing one fails the
         build rather than shipping an undocumented API. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS1591 (missing member doc) is on by default with the documentation file. CS1573 is not
         reported unless asked for: it catches a member that documents SOME parameters and silently
         omits the rest, which is exactly the state that produces a half-filled IntelliSense
         tooltip. Both are errors here so the surface cannot regress. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1573;CS1591</WarningsAsErrors>
    <NoWarn/>
    <!-- Embeds generated and untracked source files in the PDB so source-link debugging works. -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>WindowsDeviceControl</PackageId>
    <!-- Pre-1.0 on purpose: the surface is extracted from a working application and is expected to
         move before it is frozen. -->
    <Version>0.2.0</Version>
    <Description>Windows device control for .NET from an unpackaged process. Radio power; Wi-Fi enumeration, connection and profile management over the native WLAN API; Bluetooth discovery, pairing with PIN ceremony and unpairing over WinRT; Core Audio endpoint switching, volume, spatial sound, default format and file preview; internal panel brightness over the ACPI backlight interface; display topology, layouts, modes, EDID timings, scaling and HDR over CCD; power schemes, policy values, notifications, hybrid core placement and power requests; Modern Standby wake sources; wake-security policy capture and restore; volume-to-disk storage mapping.</Description>
    <PackageTags>windows;wifi;wlan;bluetooth;audio;coreaudio;spatial-audio;brightness;backlight;display;ccd;edid;hdr;power;modern-standby;storage;kiosk;iot</PackageTags>
    <Authors>Killer Pixel Crew</Authors>
    <Copyright>Copyright (c) 2026 Killer Pixel Crew</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/KillerPixelCrew/windows-device-control</PackageProjectUrl>
    <RepositoryUrl>https://github.com/KillerPixelCrew/windows-device-control</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false"/>
    <InternalsVisibleTo Include="WindowsDeviceControl.Tests"/>
  </ItemGroup>

</Project>
